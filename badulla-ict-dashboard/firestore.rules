rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return verified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function myUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function ownSchool(id) {
      return verified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myUser().status == 'approved'
        && string(myUser().census) == id;
    }
    function dataCol(c) { return c in ['ict_resources','schools','teachers','facilities','devices']; }
    function validReq() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email','name','position','phone','requestedCensus','status','created'])
        && d.keys().hasAll(['email','name','position','phone','requestedCensus','status','created'])
        && d.status == 'pending'
        && d.email == request.auth.token.email
        && d.requestedCensus is int && d.requestedCensus > 0 && d.requestedCensus < 1000000
        && d.name is string && d.name.size() > 1 && d.name.size() <= 100
        && d.position is string && d.position.size() <= 60
        && d.phone is string && d.phone.size() <= 20
        && d.created == request.time;
    }

    // Admin ලැයිස්තුව: Console එකෙන් පමණක් සාදන්න. client වලින් ලිවිය නොහැක.
    match /admins/{uid} {
      allow get: if verified() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /users/{uid} {
      allow get: if verified() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if verified() && request.auth.uid == uid && validReq();
      allow update: if isAdmin()
        || (verified() && request.auth.uid == uid && resource.data.status in ['pending','rejected'] && validReq());
      allow delete: if isAdmin();
    }
    match /{col}/{id} {
      allow get: if dataCol(col) && (isAdmin() || ownSchool(id));
      allow list: if dataCol(col) && isAdmin();
      allow create, update: if dataCol(col) && (isAdmin() || ownSchool(id))
        && request.resource.data.census is int
        && string(request.resource.data.census) == id
        && request.resource.data.keys().size() < 60;
      allow delete: if dataCol(col) && isAdmin();
    }
  }
}
