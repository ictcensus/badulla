rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return verified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function myUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function ownSchool(id) {
      return verified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myUser().status == 'approved'
        && string(myUser().census) == id;
    }
    function ownSchoolCn(cn) {
      return verified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myUser().status == 'approved'
        && string(myUser().census) == cn;
    }
    function isHW() {
      return verified() && (
        exists(/databases/$(database)/documents/hardware/$(request.auth.uid))
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && myUser().status == 'approved' && myUser().requestedCensus == 0));
    }
    function dataCol(c) { return c in ['ict_resources','schools','teachers','facilities','devices','locations']; }
    function validRepair() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ref','cn','school','div','contact','phone','items','urgent','status','created','by','report'])
        && d.status == 'new' && d.by == request.auth.uid && d.cn is string
        && d.items is list && d.items.size() > 0 && d.items.size() <= 20
        && d.contact is string && d.contact.size() <= 100 && d.phone is string && d.phone.size() <= 20
        && d.created is int;
    }
    function validReq() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email','name','position','phone','requestedCensus','status','created'])
        && d.keys().hasAll(['email','name','position','phone','requestedCensus','status','created'])
        && d.status == 'pending'
        && d.email == request.auth.token.email
        && d.requestedCensus is int && d.requestedCensus >= 0 && d.requestedCensus < 1000000
        && d.name is string && d.name.size() > 1 && d.name.size() <= 100
        && d.position is string && d.position.size() <= 60
        && d.phone is string && d.phone.size() <= 20
        && d.created == request.time;
    }

    // Admin ලැයිස්තුව: Console එකෙන් පමණක් සාදන්න. client වලින් ලිවිය නොහැක.
    match /admins/{uid} {
      allow get: if verified() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /users/{uid} {
      allow get: if verified() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if verified() && request.auth.uid == uid && validReq();
      allow update: if isAdmin()
        || (verified() && request.auth.uid == uid && resource.data.status in ['pending','rejected'] && validReq());
      allow delete: if isAdmin();
    }
    // දෘඩාංග කණ්ඩායම: admin විසින් hw_invites හි ඊමේල් එක එකතු කළ විට, එම ඊමේල් එකෙන් පිවිසි පසු hardware/{uid} සෑදේ
    match /hw_invites/{em} {
      allow read, write: if isAdmin();
      allow get: if verified() && request.auth.token.email.lower() == em;
    }
    match /hardware/{uid} {
      allow get: if verified() && (request.auth.uid == uid || isAdmin());
      allow list, delete: if isAdmin();
      allow create: if isAdmin() || (verified() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/hw_invites/$(request.auth.token.email.lower()))
        && request.resource.data.keys().hasOnly(['email','name','phone','created'])
        && request.resource.data.email == request.auth.token.email.lower());
      allow update: if false;
    }
    // අලුත්වැඩියා ඉල්ලීම්
    match /repairs/{id} {
      allow get: if isAdmin() || isHW() || ownSchoolCn(resource.data.cn);
      allow list: if isAdmin() || isHW() || ownSchoolCn(resource.data.cn);
      allow create: if (isAdmin() || ownSchoolCn(request.resource.data.cn)) && validRepair();
      allow update: if isAdmin()
        || (isHW() && resource.data.status == 'new' && request.resource.data.status == 'rec'
            && request.resource.data.acceptedBy.uid == request.auth.uid
            && request.resource.diff(resource.data).affectedKeys().hasOnly(['status','acceptedBy','acceptedAt','updated']))
        || (isHW() && resource.data.acceptedBy.uid == request.auth.uid
            && request.resource.diff(resource.data).affectedKeys().hasOnly(['status','report','receipt','updated','completedAt']))
        || (ownSchoolCn(resource.data.cn) && resource.data.status == 'fix' && !('review' in resource.data)
            && request.resource.diff(resource.data).affectedKeys().hasOnly(['review'])
            && request.resource.data.review.rating is int && request.resource.data.review.rating >= 1 && request.resource.data.review.rating <= 5
            && request.resource.data.review.comment is string && request.resource.data.review.comment.size() <= 500
            && request.resource.data.review.by == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /{col}/{id} {
      allow get: if dataCol(col) && (isAdmin() || isHW() || ownSchool(id));
      allow list: if dataCol(col) && (isAdmin() || isHW());
      allow create, update: if dataCol(col) && (isAdmin() || ownSchool(id))
        && request.resource.data.census is int
        && string(request.resource.data.census) == id
        && request.resource.data.keys().size() < 60;
      allow delete: if dataCol(col) && isAdmin();
    }
  }
}
